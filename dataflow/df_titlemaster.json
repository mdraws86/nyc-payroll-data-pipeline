{
	"name": "df_titlemaster",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_titlemaster_csv",
						"type": "DatasetReference"
					},
					"name": "loadTitleMasterCsv"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_titlemaster_sql",
						"type": "DatasetReference"
					},
					"name": "sinkTitleMasterSql"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          TitleCode as string,",
				"          TitleDescription as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> loadTitleMasterCsv",
				"loadTitleMasterCsv sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          TitleCode as string,",
				"          TitleDescription as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          TitleCode,",
				"          TitleDescription",
				"     )) ~> sinkTitleMasterSql"
			]
		}
	}
}